# Server Configuration
SERVER_PORT=8080
ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=mydb
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=1
JWT_REFRESH_EXPIRATION=168

# Rate Limiting (Redis-backed, shared across instances)
# Up to RATE_LIMIT_REQUESTS requests per client IP within RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=1

# Scheduler Configuration
# Cron expression. "@every 10m" runs every 10 minutes. Standard 5-field cron
# also works, e.g. "*/10 * * * *".
SCHEDULER_HEALTH_INTERVAL=@every 10m

# Mail (Maileroo) Configuration
# Set MAIL_ENABLED=true to send real emails via Maileroo.
# When false, a no-op mailer is used (emails are discarded, useful for dev).
MAIL_ENABLED=false
MAILEROO_API_KEY=c38c84ea8695173dfbf09e8df37aaa66c384de0e67b0b3dff90e1684452cea63
MAIL_FROM_ADDRESS=noreply@haamslab.my.id
MAIL_FROM_NAME=No-Reply
# Frontend page users visit to reset their password (token is appended as ?token=)
MAIL_FRONTEND_RESET_URL=http://localhost:3000/reset-password

# Observability
# Distributed tracing via OpenTelemetry (exported over OTLP/HTTP).
# Point OTEL_EXPORTER_OTLP_ENDPOINT at an OTel Collector, Jaeger (OTLP),
# or Grafana Tempo. Disable with OTEL_TRACING_ENABLED=false.
OTEL_SERVICE_NAME=base-repo-be-go
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_TRACES_SAMPLE_RATE=1.0

# Error tracking via Sentry. Leave SENTRY_DSN empty / SENTRY_ENABLED=false to
# disable (capture calls become no-ops).
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
